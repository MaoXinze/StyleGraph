# ===== 模型服务（阿里百炼 DashScope）=====
# VLM / LLM 走 OpenAI 兼容接口，Key 在 https://bailian.console.aliyun.com 获取
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 图数据库 =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mmkg_dev_2026

# ===== 数据与缓存（全部重定向到 D 盘项目目录）=====
# HuggingFace 缓存：CLIP 权重等，避免占用 C 盘
HF_HOME=./data/cache/huggingface
# 国内网络可启用 HF 镜像；留空则先试官方源、失败自动回退镜像
HF_ENDPOINT=

# 数据后端：modelscope（国内 CDN Range 采样，默认）/ hf（海外网络）
DATA_BACKEND=modelscope
COLLECT_ZONES=12
ZONE_BYTES_CAP=1200000000

# ===== 模型名（可在百炼控制台按可用额度调整）=====
MMKG_VLM_MODEL=qwen-vl-plus
MMKG_LLM_MODEL=qwen-plus
MMKG_CLIP_MODEL=ViT-B-32
MMKG_CLIP_PRETRAINED=openai
